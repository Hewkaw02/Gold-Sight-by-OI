# syntax=docker/dockerfile:1
FROM node:22-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    CAMOUFOX_INSTALL_DIR=/opt/camoufox

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    build-essential \
    git \
    python3 \
    python3-pip \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libdbus-glib-1-2 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    libxt6 \
    fonts-noto-color-emoji \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY collector/price/requirements.txt collector/price/requirements.txt
RUN python3 -m pip install --break-system-packages -r collector/price/requirements.txt

RUN npx camoufox-js fetch

COPY . .

RUN mkdir -p /app/public/data /app/runtime

ENV PYTHON_BIN=python3

CMD ["npm", "run", "collector:run"]
