CME_EMAIL=
CME_PASSWORD=
# Optional host port for the Docker dashboard.
# DASHBOARD_PORT=8080
# Optional local browser session path. The default is safe to keep inside this project.
# CME_STORAGE_STATE_PATH=runtime/cme-storage-state.json
GOLD_SIGHT_DATA_ROOT=public/data
GOLD_SIGHT_SYMBOL=GC
TV_SOURCE_SYMBOL=GOLD.F
TV_SOURCE_EXCHANGE=BLACKBULL
TV_SOURCE_TIMEZONE=America/Chicago
PRICE_TIMEFRAMES=4H,1D
OI_TARGET_DTES=7,15,30
OI_SESSION_SLOTS=open,mid,close
OI_P90_QUANTILE=0.9
OI_MAX_GAP_TRADING_SESSIONS=2
DISPLAY_TIMEZONE=Asia/Bangkok
CME_TIMEZONE=America/Chicago
PRICE_1D_MAX_AGE_HOURS=72
PRICE_4H_MAX_AGE_HOURS=12
OI_MAX_BUSINESS_DAY_LAG=2
OPTIONS_RISK_FREE_RATE=0.04
GOLD_OPTION_CONTRACT_MULTIPLIER=100
# Docker scheduler defaults. Times are in SCHEDULER_TIMEZONE.
# SCHEDULER_TIMEZONE=America/Chicago
# SCHEDULER_PRICE_INTERVAL_MINUTES=15
# SCHEDULER_TICK_SECONDS=30
# SCHEDULER_RUN_PRICE_ON_START=true
# SCHEDULER_RUN_OI_ON_START=true
# SCHEDULER_STARTUP_OI_SLOT=close
# SCHEDULER_PRICE_RETRIES=2
# SCHEDULER_RETRY_DELAY_SECONDS=20
# SCHEDULER_OI_SCHEDULE=07:50:open,09:55:mid,12:20:close
